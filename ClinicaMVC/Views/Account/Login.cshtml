<form asp-controller="Account"
      asp-action="Login"
      method="post">

    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <input type="text"
               class="form-control"
               name="usuario">
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input type="password"
               class="form-control"
               name="password">
    </div>

    <button type="submit" class="btn btn-success w-100">
        Iniciar Sesión
    </button>

</form>